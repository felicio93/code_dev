 _logger = logging.getLogger(__name__)
 
 
+def _polygonal_only(geom):
+    """Drop non-areal parts (lines/points) of a shapely geometry.
+
+    ``make_valid`` and ``union_all`` on resampled/self-touching rings can
+    return a ``GeometryCollection`` mixing polygons with degenerate lines and
+    points. Gmsh only needs the areal parts.
+    """
+    if isinstance(geom, (Polygon, MultiPolygon)):
+        return geom
+
+    def _collect(g):
+        if isinstance(g, Polygon):
+            return [g]
+        if isinstance(g, MultiPolygon):
+            return list(g.geoms)
+        if hasattr(g, 'geoms'):
+            return [p for sub in g.geoms for p in _collect(sub)]
+        return []
+
+    polys = [p for p in _collect(geom) if not p.is_empty]
+    if not polys:
+        return MultiPolygon()
+    dropped = geom.geom_type == 'GeometryCollection' and len(
+        [g for g in geom.geoms if not isinstance(g, (Polygon, MultiPolygon))])
+    if dropped:
+        _logger.info(
+            "Dropped %d non-polygon part(s) from GeometryCollection before "
+            "meshing.", dropped)
+    return unary_union(polys)
+
+
